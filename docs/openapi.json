    "/locations/search": {
      "get": {
        "summary": "Find locations whose service radius reaches the given point",
        "tags": [
          "locations"
        ],
        "parameters": [
          {
            "schema": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "in": "query",
            "name": "x",
            "required": true
          },
          {
            "schema": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "in": "query",
            "name": "y",
            "required": true
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user-location": {
                      "pattern": "^x=(0|[1-9][0-9]*),y=(0|[1-9][0-9]*)$",
                      "type": "string"
                    },
                    "locations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "format": "uuid",
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "coordinates": {
                            "pattern": "^x=(0|[1-9][0-9]*),y=(0|[1-9][0-9]*)$",
                            "type": "string"
                          },
                          "distance": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "coordinates",
                          "distance"
                        ]
                      }
                    }
                  },
                  "required": [
                    "user-location",
                    "locations"
                  ]
                }
              }
            }
          },
          "400": {
