# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Data
LOCATIONS_FILE=./data/locations.json
LOCATIONS_BACKEND=memory
LOAD_INVALID_FRACTION_ABORT=0.5

# Auth — REQUIRED in production. A dev fallback is used if unset (with a warning).
JWT_SECRET=
JWT_EXPIRES_IN=1h
# When AUTH_USERS is unset (the default), the server starts with two demo accounts:
#   reader / reader-secret  (role: reader — read access)
#   writer / writer-secret  (role: writer — read + write)
# Override by setting AUTH_USERS to a JSON array of { username, role: reader|writer, passwordHash: "salt:hash" }.
# Generate a passwordHash with: npm run hash-password -- <plaintext>
# AUTH_USERS=

# Rate limits (max requests per timeWindow)
RATE_LIMIT_WRITE_MAX=20
RATE_LIMIT_WRITE_WINDOW=1 minute
RATE_LIMIT_READ_MAX=120
RATE_LIMIT_READ_WINDOW=1 minute
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=1 minute
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_GLOBAL_WINDOW=1 minute

# Caching
SEARCH_CACHE_SIZE=500

# PostgreSQL (only used when LOCATIONS_BACKEND=postgres — stretch)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/locations
